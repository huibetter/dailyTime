{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DailyTime",
  "version": "0.1.3",
  "identifier": "com.huibetter.dailytime",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DailyTime · 工作节奏管理",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "app", "dmg"],
    "category": "Office",
    "shortDescription": "个人工作节奏管理工具",
    "longDescription": "DailyTime 用于组织项目文档、项目排期和日常工作内容。",
    "publisher": "Huibetter",
    "homepage": "https://github.com/huibetter/dailyTime",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:dailytime.db"]
    }
  }
}
